{
  "name": "switchly",
  "private": true,
  "version": "0.0.1",
  "description": "A lightweight, developer-friendly feature flag management toolkit for Node.js applications.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "clean": "npm run clean --workspaces"
  },
  "license": "MIT",
  "keywords": [
    "feature-flags",
    "feature-toggle",
    "typescript",
    "node",
    "feature-management"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
